{
  "name": "ptp-skills",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:site": "node --test \"site-tests/**/*.test.mjs\"",
    "check": "node tools/check.mjs",
    "build:data": "node tools/build.mjs",
    "build": "node tools/build.mjs && astro build && pagefind --site dist",
    "dev": "node tools/build.mjs && astro dev",
    "preview": "astro preview"
  },
  "dependencies": {
    "astro": "^7.4.13",
    "fflate": "^0.8.3",
    "pagefind": "^1.6.0",
    "yaml": "^2.9.1"
  }
}
