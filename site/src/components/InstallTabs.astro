---
// "내 AI에 넣기" 탭. JS가 없으면 탭 버튼 없이 다섯 안내가 차례로 모두 보인다.
// 메뉴 이름 출처(2026-11-26 다시 확인):
//  Claude 웹  https://support.claude.com/en/articles/12512180-use-skills-in-claude
//             https://support.claude.com/en/articles/12512198-how-to-create-custom-skills (description 200자)
//  Claude Code https://code.claude.com/docs/en/plugins/install
//  Cowork     https://support.claude.com/en/articles/13837440-use-plugins-in-claude
//  ChatGPT    https://help.openai.com/en/articles/10169521-projects-in-chatgpt
//             https://help.openai.com/en/articles/8554397-creating-a-gpt (개인 계정 새 GPT 불가)
//  Gemini     https://support.google.com/gemini/answer/17094296 (스킬 업로드)
//             https://support.google.com/gemini/answer/18560919 (Gem → 스킬 전환, 글·PDF·그림만 업로드)
//  Codex      https://learn.chatgpt.com/docs/build-skills ($HOME/.agents/skills)
import fs from 'node:fs';
import path from 'node:path';
import CopyBlock from './CopyBlock.astro';
import LevelMark from './LevelMark.astro';
import { url, LEVELS, REPO, MARKETPLACE_ADD, bundlesFor, installCommand } from '../lib/site.js';

interface Props { skill: any }
const { skill } = Astro.props;
const { compat, title } = skill.catalog;

function sizeOf(rel: string) {
  try {
    const kb = fs.statSync(path.join(process.cwd(), 'site/public', rel)).size / 1024;
    return kb >= 1024 ? `${(kb / 1024).toFixed(1)} MB` : `${Math.max(1, Math.round(kb))} KB`;
  } catch {
    return '';
  }
}
const claudeZip = { href: url(skill.downloads.claude), file: path.basename(skill.downloads.claude), size: sizeOf(skill.downloads.claude) };
const gptZip = { href: url(skill.downloads.gptGemini), file: path.basename(skill.downloads.gptGemini), size: sizeOf(skill.downloads.gptGemini) };

const hasInstaller = skill.files.includes('install_windows.bat');
const makesHwpx = skill.files.some((f: string) => /\.hwpx$/i.test(f));
const needsWhat = makesHwpx ? 'HWPX 파일까지 만들려면' : '이 스킬의 파일 만들기 기능을 쓰려면';
const uploadFiles = skill.files.filter((f: string) => f === 'SKILL.md' || f.startsWith('references/'));
const [mainBundle] = bundlesFor(skill);
const allBundle = bundlesFor(skill).find((b: any) => b.categories === 'all' && b !== mainBundle);
const id = (s: string) => `${skill.name}-${s}`;

const tabs = [
  { key: 'claude-web', label: 'Claude 웹', compat: compat.claude },
  { key: 'claude-code', label: 'Claude 데스크톱·Code', compat: compat.claude },
  { key: 'chatgpt', label: 'ChatGPT', compat: compat.chatgpt },
  { key: 'gemini', label: 'Gemini', compat: compat.gemini },
  { key: 'codex', label: 'Codex', compat: compat.codex },
];
const tab = Object.fromEntries(tabs.map(t => [t.key, t]));
const level = (k: string) => tab[k].compat?.level ?? 'none';
---
<div class="tabs" data-tabs>
  <div class="tabs__list" role="tablist" aria-label="사용하는 AI 고르기" data-tablist hidden>
    {tabs.map((t, i) => (
      <button type="button" role="tab" id={`tab-${t.key}`} aria-controls={`install-${t.key}`} aria-selected={i === 0 ? 'true' : 'false'} data-key={t.key}>{t.label}</button>
    ))}
  </div>

  {tabs.map(t => (
    <section class="tabpanel" id={`install-${t.key}`} data-panel={t.key}>
      <h3 class="tabpanel__title">{t.label}</h3>
      <p class={`support level-${level(t.key)}`}>
        <LevelMark level={level(t.key)} />
        <strong>{LEVELS[level(t.key)].text}</strong>
        {t.compat?.note && <span> · {t.compat.note}</span>}
      </p>

      {level(t.key) === 'none' ? (
        <p class="note note--warn">이 스킬은 {t.label}에서 동작하지 않습니다. 다른 AI를 골라 주세요.</p>
      ) : t.key === 'claude-web' ? (
        <Fragment>
          <p class="panel-lead">claude.ai 웹사이트나 Claude 데스크톱 앱의 채팅에서 쓰는 방법입니다. 스킬 파일을 한 번 올려 두면 계속 쓸 수 있습니다.</p>
          <ol class="steps">
            <li>
              <p>스킬 파일을 받습니다. <strong>압축을 풀지 말고</strong> 그대로 둡니다.</p>
              <p><a class="btn btn--primary" href={claudeZip.href} download>{claudeZip.file} 받기</a> <span class="meta">{claudeZip.size}</span></p>
            </li>
            <li><p>Claude에서 <b>설정(Settings) &gt; 기능(Capabilities)</b>으로 가서 <b>코드 실행 및 파일 생성(Code execution and file creation)</b>을 켭니다. 새 설정 화면에서는 <b>Create and edit files</b>라는 이름으로 보입니다. 스킬은 이 기능이 켜져 있어야 동작합니다.</p></li>
            <li><p><b>사용자 지정(Customize) &gt; 스킬(Skills)</b>로 갑니다. <b>+</b> 버튼을 누르고 <b>+ Create skill</b>, <b>Upload a skill</b>을 차례로 고른 뒤 1번에서 받은 zip 파일을 올립니다.</p></li>
            <li><p>스킬 목록에서 <b>{skill.name}</b> 항목이 켜져 있는지 확인합니다.</p></li>
            <li><p>새 대화를 열고 위의 요청 예시처럼 말하면 Claude가 스킬을 꺼내 씁니다.</p></li>
          </ol>
          <p class="hint">화면이 한국어로 되어 있으면 메뉴 이름이 조금 다르게 보일 수 있습니다. 메뉴 이름은 바뀔 수 있습니다. 회사 계정(Team·Enterprise)은 관리자가 스킬을 막아 두면 메뉴가 보이지 않습니다.</p>
        </Fragment>
      ) : t.key === 'claude-code' ? (
        <Fragment>
          <p class="panel-lead">Claude 데스크톱 앱과 Claude Code에서는 스킬을 묶음으로 설치합니다. 한 번 설치하면 같은 묶음에 새 스킬이 추가될 때 함께 받을 수 있습니다.</p>
          <h4>Claude 데스크톱 앱 (Cowork·Code 탭)</h4>
          <ol class="steps">
            <li><p>Claude 데스크톱 앱 왼쪽의 <b>Customize</b>를 누릅니다. 여기서 설치하면 Cowork와 Code 탭에서 함께 쓸 수 있습니다.</p></li>
            <li>
              <p><b>Plugins</b> 탭에서 <b>Add</b> &gt; <b>Add marketplace</b> &gt; <b>Add from a repository</b>를 고르고 아래 주소를 넣습니다.</p>
              <CopyBlock id={id('repo')} text={REPO} />
            </li>
            {mainBundle && <li><p><b>Discover</b> 탭에서 <b>{mainBundle.id}</b> 묶음을 고르고 <b>Add</b>를 누릅니다.</p></li>}
          </ol>
          <p class="hint">플러그인은 유료 요금제(Pro·Max·Team·Enterprise 등)에서 쓸 수 있습니다. 메뉴 이름은 바뀔 수 있습니다.</p>
          <h4>Claude Code (터미널)</h4>
          <p>PowerShell 같은 터미널에서 <code>claude</code>를 실행해 쓰는 경우입니다. 데스크톱 앱 Code 탭에서는 이 명령 대신 위 방법을 씁니다.</p>
          <ol class="steps">
            <li>
              <p>Claude Code 입력창에 아래 명령을 붙여넣고 Enter를 누릅니다. 포항TP 스킬 목록을 등록하는 단계이며, 처음 한 번만 하면 됩니다.</p>
              <CopyBlock id={id('mk-add')} text={MARKETPLACE_ADD} />
            </li>
            {mainBundle && (
              <li>
                <p>이 스킬이 들어 있는 <b>{mainBundle.title}</b>을 설치합니다.</p>
                <CopyBlock id={id('install')} text={installCommand(mainBundle)} />
                <p>설치 범위를 물으면 <b>Install for you (user scope)</b>를 고릅니다. 모든 폴더에서 쓸 수 있습니다. <code>/reload-plugins</code>를 실행하라는 문장이 나오면 그대로 입력합니다.</p>
                {allBundle && <p class="hint">포항TP 스킬을 모두 받으려면 <code>{installCommand(allBundle)}</code>를 대신 입력합니다.</p>}
              </li>
            )}
            <li><p>자동 업데이트를 켭니다. 직접 등록한 스킬 목록은 자동 업데이트가 꺼진 채로 시작합니다. <code>/plugin</code>을 입력하고 <b>Marketplaces</b> 탭에서 <b>pohang-tp</b>를 고른 뒤 자동 업데이트(auto-update)를 켭니다.</p></li>
          </ol>
          {hasInstaller && (
            <div class="note">
              <p><strong>{needsWhat} PC에 Python이 필요합니다.</strong> 처음 한 번만 하면 됩니다.</p>
              <ol>
                <li>python.org에서 Python 3.10 이상을 설치합니다. 설치 화면에 <b>Add python.exe to PATH</b>가 보이면 꼭 체크합니다.</li>
                <li>Claude(데스크톱 앱 Code 탭이나 Claude Code)에 <q>install_windows.bat 실행해줘</q>라고 요청합니다. Claude가 스킬 폴더에 있는 이 파일을 찾아 실행합니다. <b>[성공]</b> 문장이 나오면 끝입니다.</li>
              </ol>
              <p>플러그인이 업데이트된 뒤 설치 안내가 다시 나오면 install_windows.bat을 한 번 더 실행하세요.</p>
            </div>
          )}
        </Fragment>
      ) : t.key === 'chatgpt' ? (
        <Fragment>
          <p class="panel-lead">개인 계정(무료·Go·Plus·Pro)에서는 새 맞춤형 GPT를 만들 수 없게 바뀌었습니다. 대신 모든 요금제에서 쓸 수 있는 <b>프로젝트</b>에 지침과 문서를 넣어 씁니다.</p>
          <ol class="steps">
            <li>
              <p>GPT·Gemini용 파일을 받아 <strong>압축을 풉니다</strong>.</p>
              <p><a class="btn btn--primary" href={gptZip.href} download>{gptZip.file} 받기</a> <span class="meta">{gptZip.size}</span></p>
            </li>
            <li><p>ChatGPT 왼쪽 사이드바에서 <b>새 프로젝트(New project)</b>를 누르고 이름을 <q>{title}</q>처럼 정합니다.</p></li>
            <li>
              <p>프로젝트의 <b>•••</b> 메뉴에서 <b>프로젝트 설정(Project settings)</b>을 열고 지침 칸에 아래 글을 붙여넣습니다.</p>
              {skill.overLimit ? (
                <Fragment>
                  <p class="note">지침이 길어 붙여넣기 칸에 다 들어가지 않습니다. 아래의 짧은 사용법 문구를 붙여넣고, 지침 전체는 4번에서 파일(SKILL.md)로 올립니다.</p>
                  <CopyBlock id={id('starter-gpt')} text={skill.starterPrompt} label="사용법 문구 복사" variant="text" />
                </Fragment>
              ) : (
                <Fragment>
                  <button type="button" class="btn btn--secondary btn-copy-full" data-copy-target={id('instructions')}>지침 전체 복사</button>
                  <details class="fulltext">
                    <summary>지침 전체 보기</summary>
                    <pre id={id('instructions')}>{skill.instructions.trim()}</pre>
                  </details>
                </Fragment>
              )}
            </li>
            <li>
              <p>프로젝트에 파일을 추가합니다. 압축을 푼 폴더에서 아래 파일을 올립니다.</p>
              <ul class="filelist">{uploadFiles.map((f: string) => <li><code>{f}</code></li>)}</ul>
              <p class="hint">무료 요금제는 프로젝트 하나에 파일 5개까지 올릴 수 있습니다.</p>
            </li>
            <li><p>그 프로젝트 안에서 새 대화를 열고 요청 예시처럼 요청합니다.</p></li>
          </ol>
          <p class="hint">회사 워크스페이스(Business·Enterprise)는 관리자가 허용하면 맞춤형 GPT나 스킬로도 넣을 수 있습니다. 메뉴 이름은 바뀔 수 있습니다.</p>
        </Fragment>
      ) : t.key === 'gemini' ? (
        <Fragment>
          <p class="panel-lead">개인 Google 계정은 2026년 11월 17일부터 Gem을 새로 만들 수 없고, 대신 <b>스킬</b>로 넣습니다. 받은 zip 파일을 그대로 올리면 됩니다.</p>
          <ol class="steps">
            <li>
              <p>GPT·Gemini용 파일을 받습니다. <strong>압축을 풀지 말고</strong> 그대로 둡니다.</p>
              <p><a class="btn btn--primary" href={gptZip.href} download>{gptZip.file} 받기</a> <span class="meta">{gptZip.size}</span></p>
            </li>
            <li><p>PC 브라우저로 gemini.google.com에 들어갑니다. 휴대폰 앱에서는 파일을 올릴 수 없고, 스킬은 만 18세 이상 계정에서 쓸 수 있습니다.</p></li>
            <li><p>왼쪽 사이드바에서 <b>맞춤설정(Customize)</b>을 누르고 위쪽의 <b>스킬(Skills)</b>을 엽니다. Customize가 보이지 않으면 <b>더보기(More)</b>를 먼저 누릅니다.</p></li>
            <li><p><b>만들기(Create)</b> &gt; <b>업로드(Upload)</b>를 누르고 1번에서 받은 zip 파일을 고른 뒤 <b>열기(Open)</b>를 누릅니다.</p></li>
            <li><p>내용을 확인하고 <b>만들기(Create)</b>를 누릅니다.</p></li>
            <li><p>새 대화를 열고 요청 예시처럼 요청합니다.</p></li>
          </ol>
          <p class="hint">이 zip에는 Gemini가 받는 글·PDF·그림 파일만 넣었습니다(HWPX 양식은 빠집니다). 그래도 업로드가 안 되면 압축을 풀고 <code>SKILL.md</code> 파일 하나만 올려도 지침은 들어갑니다. 회사·학교 Google 계정은 2027년 3월(교육용은 6월)까지 Gem을 계속 쓸 수 있으니, Gem을 만들어 ChatGPT 탭의 3·4번처럼 지침과 파일을 넣어도 됩니다. 메뉴 이름은 바뀔 수 있습니다.</p>
        </Fragment>
      ) : (
        <Fragment>
          <p class="panel-lead">Codex는 정해진 폴더에 있는 스킬을 자동으로 읽습니다. Claude용 파일을 그대로 씁니다.</p>
          <ol class="steps">
            <li>
              <p>Claude용 파일을 받아 <strong>압축을 풉니다</strong>. 안에 <code>{skill.name}</code> 폴더가 있습니다.</p>
              <p><a class="btn btn--primary" href={claudeZip.href} download>{claudeZip.file} 받기</a> <span class="meta">{claudeZip.size}</span></p>
            </li>
            <li>
              <p>파일 탐색기 주소창에 아래 경로를 붙여넣고 Enter를 누릅니다. 폴더가 없다고 나오면 <code>C:\Users\내 이름</code> 폴더 안에 <code>.agents</code> 폴더를, 그 안에 <code>skills</code> 폴더를 만듭니다.</p>
              <CopyBlock id={id('codex-dir')} text="%USERPROFILE%\.agents\skills" />
            </li>
            <li><p><code>{skill.name}</code> 폴더를 통째로 그 안에 옮깁니다. <code>skills\{skill.name}\SKILL.md</code> 모양이 되면 맞습니다. Mac은 <code>~/.agents/skills</code> 폴더에 넣습니다.</p></li>
            {hasInstaller && (
              <li><p>{needsWhat} Python 3.10 이상이 필요합니다. python.org에서 Python을 설치하고(설치 화면에 <b>Add python.exe to PATH</b>가 보이면 체크), 옮긴 폴더의 <code>install_windows.bat</code>을 더블클릭합니다. <b>[성공]</b> 문장이 나오면 끝입니다.</p></li>
            )}
            <li><p>Codex에서 요청 예시처럼 요청합니다. Codex가 새 스킬을 알아서 찾습니다. 보이지 않을 때만 Codex를 다시 시작합니다.</p></li>
          </ol>
        </Fragment>
      )}
    </section>
  ))}

</div>

<script>
  // 탭: 버튼 role=tab + aria-selected, 화살표·Home·End로 이동. 마지막에 고른 AI를 기억한다.
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const list = root.querySelector<HTMLElement>('[data-tablist]');
    if (!list) continue;
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map(t => document.getElementById(t.getAttribute('aria-controls') ?? ''));
    if (panels.some(p => !p)) continue;
    list.hidden = false;
    root.classList.add('is-tabbed');
    panels.forEach((p, i) => {
      p!.setAttribute('role', 'tabpanel');
      p!.setAttribute('aria-labelledby', tabs[i].id);
      p!.tabIndex = 0;
    });
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        const on = i === j;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        panels[j]!.hidden = !on;
      });
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => {
        select(i);
        try { localStorage.setItem('ptp-ai', t.dataset.key ?? ''); } catch {}
      });
      t.addEventListener('keydown', e => {
        const n = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
        if (n === undefined) return;
        e.preventDefault();
        select((n + tabs.length) % tabs.length, true);
      });
    });
    let start = panels.findIndex(p => p!.id === location.hash.slice(1));
    if (start < 0) {
      try { start = tabs.findIndex(t => t.dataset.key === localStorage.getItem('ptp-ai')); } catch {}
    }
    select(Math.max(0, start));
    // 옆 패널의 "바로 넣기" 링크(#install-<key>)를 누르면 그 탭을 열고 탭 줄로 이동한다.
    window.addEventListener('hashchange', () => {
      const i = panels.findIndex(p => p!.id === location.hash.slice(1));
      if (i < 0) return;
      select(i);
      list.scrollIntoView({ block: 'start' });
    });
  }
</script>
