---
import Compat from './Compat.astro';
import { skillUrl, formatDate, lastUpdated } from '../lib/site.js';
interface Props { skill: any }
const { skill } = Astro.props;
const updated = lastUpdated(skill);
---
<article class="card">
  <h3 class="card__title"><a href={skillUrl(skill)}>{skill.catalog.title}</a></h3>
  <p class="card__summary">{skill.catalog.summary}</p>
  <Compat compat={skill.catalog.compat} />
  <div class="card__foot">
    <p class="card__meta">
      <span>버전 {skill.catalog.version}</span>
      {updated && <span>업데이트 <time datetime={updated}>{formatDate(updated)}</time></span>}
    </p>
    <span class="card__cta" aria-hidden="true">넣는 방법 보기 <svg viewBox="0 0 24 24"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg></span>
  </div>
</article>
