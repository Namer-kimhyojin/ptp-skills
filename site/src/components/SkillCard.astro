---
import Compat from './Compat.astro';
import { skillUrl, formatDate, lastUpdated, outputLabels, AIS } from '../lib/site.js';
interface Props { skill: any; hidden?: boolean }
const { skill, hidden = false } = Astro.props;
const updated = lastUpdated(skill);
const outputs = outputLabels(skill);
// AI 필터(AiFilter)가 읽는 지원 수준: data-claude="full" 처럼 붙인다.
const aiData = Object.fromEntries(AIS.map(ai => [`data-${ai.key}`, skill.catalog.compat[ai.key]?.level ?? 'none']));
---
<article class="card" data-card hidden={hidden} {...aiData}>
  <h3 class="card__title"><a href={skillUrl(skill)}>{skill.catalog.title}</a></h3>
  <p class="card__summary">{skill.catalog.summary}</p>
  <Compat compat={skill.catalog.compat} />
  <div class="card__foot">
    <p class="card__meta">
      {outputs.length > 0 && <span>결과물 {outputs.join(' · ')}</span>}
      {updated && <span>업데이트 <time datetime={updated}>{formatDate(updated)}</time></span>}
    </p>
    <span class="card__cta" aria-hidden="true">넣는 방법 보기 <svg viewBox="0 0 24 24"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg></span>
  </div>
</article>
