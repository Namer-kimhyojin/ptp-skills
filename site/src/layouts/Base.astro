---
import '../styles/global.css';
import { url, SITE_NAME, REPO_URL } from '../lib/site.js';

interface Props {
  title?: string;
  description: string;
  current?: 'home' | 'install' | 'contribute';
}
const { title, description, current } = Astro.props;
const fullTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME}: 포항테크노파크 직원용 AI 업무 스킬`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const nav = [
  { key: 'install', href: url('install/'), label: '설치 안내' },
  { key: 'contribute', href: url('contribute/'), label: '참여하기' },
];
---
<!doctype html>
<html lang="ko" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">본문 바로가기</a>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href={url()} aria-current={current === 'home' ? 'page' : undefined}>
          <svg class="brand__mark" viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" rx="5" /><path d="M7 7h10M7 12h10M7 17h6" /></svg>
          <span>{SITE_NAME}</span>
        </a>
        <nav aria-label="주 메뉴">
          <ul class="site-nav">
            {nav.map(n => (
              <li><a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <div class="site-footer__about">
          <p class="site-footer__brand">{SITE_NAME}</p>
          <p>포항테크노파크 직원 업무용으로 공개한 자료입니다. 다른 곳에 다시 쓰려면 먼저 문의해 주세요.</p>
        </div>
        <nav aria-label="바닥 메뉴">
          <ul class="site-footer__links">
            <li><a href={url()}>스킬 목록</a></li>
            {nav.map(n => <li><a href={n.href}>{n.label}</a></li>)}
            <li><a href={REPO_URL}>GitHub 저장소</a></li>
          </ul>
        </nav>
      </div>
    </footer>
    <p class="sr-only" aria-live="polite" data-copy-status></p>
    <script is:inline>
      // 복사 버튼: data-copy-target 요소의 글자를 클립보드에 넣고 "복사됨"을 잠시 보여 준다.
      document.addEventListener('click', async (e) => {
        const btn = e.target.closest('[data-copy-target]');
        if (!btn) return;
        const src = document.getElementById(btn.dataset.copyTarget);
        if (!src) return;
        const text = (src.value ?? src.textContent).trim();
        const status = document.querySelector('[data-copy-status]');
        const label = btn.dataset.label || (btn.dataset.label = btn.textContent);
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = '복사됨';
          btn.classList.add('is-done');
          if (status) status.textContent = '복사했습니다. 붙여넣기 하세요.';
        } catch {
          const range = document.createRange();
          range.selectNodeContents(src);
          const sel = getSelection();
          sel.removeAllRanges();
          sel.addRange(range);
          btn.textContent = 'Ctrl+C로 복사';
          if (status) status.textContent = '자동 복사가 막혀 있습니다. 선택된 글자를 Ctrl+C로 복사하세요.';
        }
        clearTimeout(btn._t);
        btn._t = setTimeout(() => {
          btn.textContent = label;
          btn.classList.remove('is-done');
        }, 2500);
      });
    </script>
  </body>
</html>
