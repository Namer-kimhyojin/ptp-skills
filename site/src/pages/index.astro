---
import Base from '../layouts/Base.astro';
import SkillGroup from '../components/SkillGroup.astro';
import AiFilter from '../components/AiFilter.astro';
import QuickSearch from '../components/QuickSearch.astro';
import { url, skills, categories, categoryId, skillUrl, skillsIn, formatDate, plainSubject, lastUpdated, HOME_LIMIT } from '../lib/site.js';

const groups = categories
  .map(c => ({ category: c, id: categoryId(c), items: skillsIn(c) }))
  .filter(g => g.items.length > 0);

// 최근 업데이트: 스킬마다 가장 최근 변경 한 건만 보여 준다(같은 스킬이 줄줄이 반복되지 않게).
const recent = skills
  .filter(s => s.history.length > 0)
  .map(s => ({ ...s.history[0], skill: s }))
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 6);
const newest = skills.map(lastUpdated).sort().at(-1);
// 첫 화면 오른쪽 미리보기: 실제 스킬의 요청 예시와 결과물로 보여 준다.
// 스킬이 없어지면 미리보기는 빠진다.
const demo = skills.find(s => s.name === 'ptp-press');
const demoAsk = demo?.catalog.examples[0] ?? '';
---
<Base description="포항테크노파크 직원이 Claude·ChatGPT·Gemini 앱에 넣어 쓰는 업무 스킬 모음입니다. 스킬을 찾고, 안내에 따라 내 AI에 넣으세요." current="home">
  <section class="hero-wrap">
    <div class="wrap">
      <div class="hero">
        <div class="hero__grid">
        <div class="hero__main">
        <p class="kicker"><span class="dot" aria-hidden="true"></span>포항테크노파크 · AI 업무 스킬</p>
        <h1>AI에게 우리 기관의 일하는 방식을 알려 주세요.</h1>
        <p class="lead">스킬은 AI에게 포항TP의 업무 방식과 양식을 알려 주는 지침 묶음입니다. 필요한 스킬을 골라 안내대로 내 AI에 넣으면 됩니다. 쓰기만 할 때는 GitHub 계정이 필요 없습니다.</p>

        <div class="search">
          <QuickSearch />
          <noscript>
            <p class="hint">검색은 JavaScript가 켜져 있어야 동작합니다. 아래 분류에서 찾아 주세요.</p>
          </noscript>
        </div>

        <nav class="chips" aria-label="업무 분류">
          {groups.map(g => <a class="chip" href={`#${g.id}`}>{g.category} <span class="chip__count" data-chip-count={g.id}>{g.items.length}</span></a>)}
        </nav>
        </div>

        {demo && (
          <div class="preview" aria-hidden="true">
            <div class="preview__bar"><span></span><span></span><span></span><b>내 AI</b></div>
            <div class="preview__body">
              <p class="bubble bubble--me">{demoAsk}</p>
              <p class="preview__skill"><span class="dot"></span>{demo.catalog.title} 스킬을 꺼내 씁니다</p>
              <div class="bubble bubble--ai">
                <p>포항TP 보도자료 양식에 맞춰 초안을 만들고, 제목 길이와 표기를 검수했습니다.</p>
                <div class="file">
                  <span class="file__icon">HWPX</span>
                  <span><b>보도자료_초안.hwpx</b><small>한글 파일</small></span>
                </div>
              </div>
            </div>
          </div>
        )}
        </div>

        <dl class="stats">
          <div><dt>등록된 스킬</dt><dd>{skills.length}<small>개</small></dd></div>
          <div><dt>업무 분류</dt><dd>{groups.length}<small>개</small></dd></div>
          <div><dt>지원하는 AI</dt><dd>4<small>종</small></dd></div>
          {newest && <div><dt>최근 업데이트</dt><dd><time datetime={newest}>{formatDate(newest)}</time></dd></div>}
        </dl>
      </div>
    </div>
  </section>

  <section class="howto" aria-labelledby="howto-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="howto-h" class="section-title">이렇게 씁니다</h2>
        <p class="section-head__aside">처음 한 번만 넣어 두면, 그다음부터는 평소처럼 AI에게 말하면 됩니다.</p>
      </div>
      <ol class="howto__list">
        <li class="step-card">
          <span class="pill">STEP 01</span>
          <b>스킬 고르기</b>
          <span>업무 이름으로 찾거나 분류에서 고릅니다.</span>
        </li>
        <li class="step-card step-card--accent">
          <span class="pill">STEP 02</span>
          <b>내 AI에 넣기</b>
          <span>쓰는 AI를 고르고 안내 순서대로 따라 합니다.</span>
        </li>
        <li class="step-card">
          <span class="pill">STEP 03</span>
          <b>평소처럼 요청하기</b>
          <span>요청 예시처럼 말하면 AI가 스킬을 꺼내 씁니다.</span>
        </li>
      </ol>
    </div>
  </section>

  <div class="wrap home-grid">
    <div class="home-grid__main">
      <AiFilter />
      {groups.map(g => <SkillGroup category={g.category} items={g.items} limit={HOME_LIMIT} />)}
    </div>

    <aside class="home-grid__side" aria-labelledby="recent-h">
      <h2 id="recent-h">최근 업데이트</h2>
      <ol class="recent">
        {recent.map(r => (
          <li>
            <time datetime={r.date}>{formatDate(r.date)}</time>
            <a href={skillUrl(r.skill)}>{r.skill.catalog.title}</a>
            <span>{plainSubject(r.subject)}</span>
          </li>
        ))}
      </ol>
    </aside>
  </div>

  <section class="band" aria-labelledby="band-h">
    <div class="wrap band__inner">
      <div>
        <h2 id="band-h">필요한 스킬이 없나요?</h2>
        <p>스킬은 직원들이 함께 만들고 고칩니다. 요청만 남겨도 되고, 직접 만들어 올릴 수도 있습니다.</p>
      </div>
      <a class="btn btn--accent" href={url('contribute/')}>참여하는 방법 보기
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </div>
  </section>

</Base>
